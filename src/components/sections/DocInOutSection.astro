---
import { getApp } from '../../data/apps';
import VoteWidget from '../VoteWidget.astro';
const app = getApp('docinout')!;
---
<section id="docinout" class="relative overflow-hidden bg-[var(--color-cream)] py-20 md:py-28 lg:py-36">
  <!-- pulse wash -->
  <div aria-hidden="true" class="absolute -top-32 -right-20 h-[460px] w-[460px] rounded-full blur-3xl opacity-15"
    style="background: radial-gradient(closest-side, var(--color-pulse), transparent 70%);"></div>

  <div class="container-x relative">
    <div class="grid grid-cols-12 items-end gap-6 mb-16">
      <div class="col-span-12 md:col-span-6">
        <span class="eyebrow text-[var(--color-pulse-deep)]">App 04 &nbsp;/&nbsp; {app.category}</span>
        <p class="mt-3 font-tamil text-2xl text-[var(--color-ink)]/60">{app.tamilName}</p>
      </div>
      <div class="col-span-12 md:col-span-6 md:text-right">
        <p class="text-sm text-[var(--color-ink)]/55 max-w-md md:ml-auto">
          The same clock InOut runs on TASMAC shops, now on every government doctor in Tamil Nadu - with an AI on the health department dashboard watching for problems.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-y-8 md:gap-16 items-start">
      <div class="col-span-12 lg:col-span-7 reveal">
        <h2 class="font-display text-[40px] sm:text-[56px] md:text-[72px] lg:text-[88px] leading-[1.0] tracking-[-0.02em]">
          {app.name}.<br/>
          <span class="italic font-[450]" style="color: var(--color-pulse-deep);">{app.tagline}</span>
        </h2>

        <p class="mt-8 max-w-xl text-[17px] leading-[1.6] text-[var(--color-ink)]/75">
          {app.longDescription}
        </p>

        <p class="mt-4 text-[12px] sm:text-[13px] font-mono uppercase tracking-[0.2em] text-[var(--color-rust)]">
          &mdash;&nbsp; If you have a problem, just whistle.
        </p>

        <div class="mt-12 flex flex-wrap gap-3 items-center">
          <a href={`/apps/${app.slug}`} class="btn text-[var(--color-cream)]" style="background: var(--color-pulse);">
            Open the {app.name} page
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#download" class="btn btn-ghost">Download</a>
          <VoteWidget slug={app.slug} accent="pulse" variant="light" />
        </div>
      </div>

      <!-- doctor profile mockup with absent flag -->
      <div class="col-span-12 lg:col-span-5 reveal">
        <div class="relative">
          <div class="absolute inset-0 -rotate-1 rounded-[24px] bg-[var(--color-cream-3)]/60"></div>
          <article class="relative rounded-[24px] bg-white shadow-[0_40px_80px_-30px_rgba(14,14,14,0.25)] border border-[var(--color-line)] overflow-hidden">
            <!-- status banner -->
            <div class="bg-[color-mix(in_srgb,var(--color-rust)_12%,white)] border-b border-[var(--color-line)] px-5 py-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="relative flex">
                  <span class="absolute h-2 w-2 rounded-full bg-[var(--color-rust)] opacity-60 animate-ping"></span>
                  <span class="relative h-2 w-2 rounded-full bg-[var(--color-rust)]"></span>
                </span>
                <span class="text-[11px] uppercase tracking-wider text-[var(--color-rust-deep)] font-semibold">Absent &middot; 47 min late</span>
              </div>
              <span class="font-mono text-[10.5px] text-[var(--color-ink)]/55">9:47 AM</span>
            </div>

            <!-- doctor header -->
            <div class="p-5 border-b border-[var(--color-line)]">
              <p class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/50">PHC Vellore South &middot; TN-44</p>
              <p class="font-display text-2xl tracking-tight mt-0.5">Dr. R. Anitha</p>
              <p class="text-[11px] text-[var(--color-ink)]/55 mt-1">MBBS &middot; General Medicine &middot; Shift 09:00 - 13:00</p>
            </div>

            <!-- today's log -->
            <div class="p-5">
              <p class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/50 mb-3">Today</p>
              <ol class="relative space-y-3">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-[var(--color-ink)]/40 shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium text-[var(--color-ink)]/65">Expected check-in</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">9:00 AM</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-[var(--color-rust)] shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium text-[var(--color-rust-deep)]">Auto-flag: no check-in</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">9:15 AM &middot; AI escalated to DMS</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-amber-500 shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium">Patient whistle</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">9:32 AM &middot; missed appointment</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-[var(--color-pulse)] shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium" style="color: var(--color-pulse-deep);">Backup posted</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">9:38 AM &middot; Dr. K. Suresh covering</p>
                  </div>
                </li>
              </ol>
            </div>

            <!-- footer -->
            <div class="border-t border-[var(--color-line)] px-5 py-4 flex items-center justify-between gap-2">
              <span class="text-[11px] text-[var(--color-ink)]/55">22 / 30 days on time</span>
              <button class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] px-3 py-1.5 text-[11.5px] font-semibold shadow-[0_6px_20px_-6px_rgba(214,41,62,0.55)]">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <rect x="3" y="10.5" width="4" height="3" rx="0.5"/>
                  <path d="M7 9 H14 A4 4 0 0 1 14 17 H7 Z"/>
                  <circle cx="11.5" cy="13" r="1.3" fill="var(--color-rust)"/>
                  <circle cx="17.5" cy="7.5" r="1.2" fill="none" stroke="currentColor" stroke-width="1.2"/>
                </svg>
                Whistle
              </button>
            </div>
          </article>
        </div>
      </div>
    </div>

    <!-- feature pillars -->
    <div class="mt-24 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-line)] rounded-2xl overflow-hidden border border-[var(--color-line)]">
      {app.features.slice(0, 4).map((f, i) => (
        <div class="bg-[var(--color-cream)] p-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="font-mono text-[11px] text-[var(--color-pulse-deep)]">F.0{i + 1}</span>
            <span class="h-px flex-1 bg-[var(--color-line)]"></span>
          </div>
          <h3 class="font-display text-xl tracking-tight">{f.title}</h3>
          <p class="mt-2 text-[14px] text-[var(--color-ink)]/65 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- stats inline -->
    <div class="mt-12 flex flex-wrap items-baseline gap-x-12 gap-y-4">
      {app.stats.map((s) => (
        <div class="flex items-baseline gap-3">
          <span class="font-display text-3xl tracking-tight" style="color: var(--color-pulse-deep);">{s.value}</span>
          <span class="text-xs uppercase tracking-wider text-[var(--color-ink)]/55">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
