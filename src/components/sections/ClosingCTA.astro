---
import { apps } from '../../data/apps';
---
<section id="download" class="relative bg-[var(--color-cream)] py-24 md:py-32 overflow-hidden">
  <div class="container-x">
    <div class="rounded-[28px] relative overflow-hidden p-7 sm:p-10 md:p-16 grain"
      style="background: linear-gradient(135deg, var(--color-cream-2) 0%, var(--color-cream-3) 100%);">
      <div aria-hidden="true" class="absolute -top-32 -right-20 h-[460px] w-[460px] rounded-full blur-3xl opacity-30"
        style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>

      <div class="relative grid grid-cols-12 gap-y-8 md:gap-8 items-end">
        <div class="col-span-12 md:col-span-7">
          <span class="eyebrow text-[var(--color-rust)]">Download &nbsp;/&nbsp; coming Q3 2026</span>
          <h2 class="mt-4 font-display text-[36px] sm:text-[56px] md:text-[72px] lg:text-[80px] leading-[1.0] tracking-[-0.02em] max-w-[14ch]">
            Six apps.<br/>
            <span class="italic font-[450]">One Tamil Nadu.</span>
          </h2>
          <p class="mt-6 max-w-lg text-[17px] leading-[1.55] text-[var(--color-ink)]/75">
            Sign up for the waiting list and we'll send you the first version the day it's ready. No spam, no marketing,
            no outside trackers.
          </p>
        </div>

        <div class="col-span-12 md:col-span-5">
          <form class="rounded-2xl bg-[var(--color-cream)] border border-[var(--color-line)] p-3 flex items-center gap-2">
            <input type="email" required placeholder="you@example.com"
              class="flex-1 bg-transparent px-3 py-2.5 text-[15px] placeholder:text-[var(--color-ink)]/40 focus:outline-none"/>
            <button type="submit" class="btn btn-ink whitespace-nowrap">
              Notify me
            </button>
          </form>
          <p class="mt-3 text-[11px] text-[var(--color-ink)]/50">
            By signing up you agree to the <a href="#" class="underline">privacy policy</a>.
          </p>

          <div class="mt-8 flex items-center gap-3 text-xs text-[var(--color-ink)]/55">
            <span>Available on</span>
            <span class="flex items-center gap-1.5 font-medium text-[var(--color-ink)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5V3.5a1 1 0 0 1 1.5-.87l15 8.5a1 1 0 0 1 0 1.74l-15 8.5A1 1 0 0 1 3 20.5z"/></svg>
              Android
            </span>
            <span class="flex items-center gap-1.5 font-medium text-[var(--color-ink)]/40">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 12.5a4.5 4.5 0 0 1 2.5-4 4.5 4.5 0 0 0-3.5-2c-1.5 0-2.5 1-4 1s-2.5-1-4-1c-2.5 0-5 2-5 6.5C3.5 16.5 6 22 9 22c1 0 2-1 3.5-1s2.5 1 3.5 1c1 0 2-2 3-4-1.5-1-2.5-3-1.5-5.5z"/></svg>
              iOS (soon)
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
