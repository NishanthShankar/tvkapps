---
import { getApp } from '../../data/apps';
const app = getApp('nilam')!;
---
<section id="nilam" class="relative overflow-hidden bg-[var(--color-cream)] py-24 md:py-36">
  <div class="container-x">
    <!-- top metadata -->
    <div class="grid grid-cols-12 items-end gap-6 mb-16">
      <div class="col-span-12 md:col-span-6">
        <span class="eyebrow text-[var(--color-leaf)]">App 02 &nbsp;/&nbsp; {app.category}</span>
        <p class="mt-3 font-tamil text-2xl text-[var(--color-ink)]/60">{app.tamilName}</p>
      </div>
      <div class="col-span-12 md:col-span-6 md:text-right">
        <p class="text-sm text-[var(--color-ink)]/55 max-w-md md:ml-auto">
          Built on a unified parcel database that talks to the Survey, Registration, and Revenue departments simultaneously.
        </p>
      </div>
    </div>

    <!-- asymmetric split: 7/5 -->
    <div class="grid grid-cols-12 gap-8 md:gap-16 items-start">
      <!-- left, taller -->
      <div class="col-span-12 lg:col-span-7 reveal">
        <h2 class="font-display text-[44px] sm:text-[64px] md:text-[88px] leading-[0.98] tracking-[-0.02em]">
          {app.name}.<br/>
          <span class="italic font-[450] text-[var(--color-leaf)]">{app.tagline}</span>
        </h2>

        <p class="mt-8 max-w-xl text-[17px] leading-[1.6] text-[var(--color-ink)]/75">
          {app.longDescription}
        </p>

        <div class="mt-12 flex flex-wrap gap-3">
          <a href={`/apps/${app.slug}`} class="btn bg-[var(--color-leaf)] text-[var(--color-cream)] hover:bg-[var(--color-leaf-deep)]">
            Open the {app.name} page
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#download" class="btn btn-ghost">Download</a>
        </div>
      </div>

      <!-- right: stylized land record card with map -->
      <div class="col-span-12 lg:col-span-5 reveal">
        <div class="relative">
          <div class="absolute inset-0 -rotate-2 rounded-[24px] bg-[var(--color-cream-3)]/60"></div>
          <article class="relative rounded-[24px] bg-white shadow-[0_40px_80px_-30px_rgba(14,14,14,0.25)] border border-[var(--color-line)] overflow-hidden">
            <!-- map header -->
            <div class="relative h-44 bg-[#dfe7d8] overflow-hidden">
              <!-- pseudo-map grid -->
              <svg viewBox="0 0 400 180" class="absolute inset-0 w-full h-full" preserveAspectRatio="none">
                <defs>
                  <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(31,95,63,0.15)" stroke-width="0.5"/>
                  </pattern>
                </defs>
                <rect width="400" height="180" fill="url(#grid)"/>
                <!-- parcels -->
                <path d="M 30 30 L 130 25 L 140 90 L 50 100 Z" fill="rgba(31,95,63,0.15)" stroke="var(--color-leaf)" stroke-width="1.2"/>
                <path d="M 130 25 L 240 35 L 250 95 L 140 90 Z" fill="rgba(31,95,63,0.28)" stroke="var(--color-leaf)" stroke-width="1.6"/>
                <path d="M 240 35 L 360 40 L 370 120 L 250 95 Z" fill="rgba(31,95,63,0.12)" stroke="var(--color-leaf)" stroke-width="1.2"/>
                <path d="M 50 100 L 140 90 L 150 160 L 60 170 Z" fill="rgba(31,95,63,0.1)" stroke="var(--color-leaf)" stroke-width="1.2"/>
                <path d="M 140 90 L 250 95 L 260 165 L 150 160 Z" fill="rgba(31,95,63,0.15)" stroke="var(--color-leaf)" stroke-width="1.2"/>
                <!-- highlighted parcel label -->
                <circle cx="190" cy="65" r="6" fill="var(--color-leaf)"/>
                <circle cx="190" cy="65" r="11" fill="none" stroke="var(--color-leaf)" stroke-width="1" opacity="0.4"/>
              </svg>
              <div class="absolute bottom-3 left-4 right-4 flex justify-between items-end text-[10px] uppercase tracking-wider text-[var(--color-leaf-deep)]/80 font-medium">
                <span>Survey 142/3B</span>
                <span>Sengipatti village</span>
              </div>
            </div>
            <!-- record body -->
            <div class="p-6">
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/50">Patta extract</p>
                  <p class="font-display text-2xl tracking-tight mt-1">P-2419/2024</p>
                </div>
                <span class="rounded-full bg-[color-mix(in_srgb,var(--color-leaf)_15%,transparent)] px-2.5 py-1 text-[10px] uppercase tracking-wider text-[var(--color-leaf-deep)] font-semibold">Verified</span>
              </div>

              <dl class="mt-5 grid grid-cols-2 gap-y-3 text-[12px]">
                <dt class="text-[var(--color-ink)]/50">Owner</dt>
                <dd class="font-medium">M. Rajalakshmi</dd>
                <dt class="text-[var(--color-ink)]/50">Extent</dt>
                <dd class="font-medium">1.42 acres</dd>
                <dt class="text-[var(--color-ink)]/50">Classification</dt>
                <dd class="font-medium">Wet (Nanjai)</dd>
                <dt class="text-[var(--color-ink)]/50">Last mutation</dt>
                <dd class="font-medium">Mar 2024</dd>
              </dl>

              <div class="mt-6 pt-4 border-t border-[var(--color-line)] flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-leaf)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  <span class="text-[10px] text-[var(--color-ink)]/60">Signed via Digital India Stack</span>
                </div>
                <button class="text-[11px] font-medium text-[var(--color-leaf-deep)]">Download PDF</button>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>

    <!-- feature pillars - 4 columns -->
    <div class="mt-24 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-line)] rounded-2xl overflow-hidden border border-[var(--color-line)]">
      {app.features.map((f, i) => (
        <div class="bg-[var(--color-cream)] p-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="font-mono text-[11px] text-[var(--color-leaf)]">F.0{i + 1}</span>
            <span class="h-px flex-1 bg-[var(--color-line)]"></span>
          </div>
          <h3 class="font-display text-xl tracking-tight">{f.title}</h3>
          <p class="mt-2 text-[14px] text-[var(--color-ink)]/65 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- stats inline -->
    <div class="mt-12 flex flex-wrap items-baseline gap-x-12 gap-y-4">
      {app.stats.map((s) => (
        <div class="flex items-baseline gap-3">
          <span class="font-display text-3xl tracking-tight text-[var(--color-leaf)]">{s.value}</span>
          <span class="text-xs uppercase tracking-wider text-[var(--color-ink)]/55">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
