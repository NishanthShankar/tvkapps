---
import { getApp } from '../../data/apps';
import VoteWidget from '../VoteWidget.astro';
const app = getApp('makkal-kural')!;
---
<section id="makkal-kural" class="relative isolate overflow-hidden bg-[var(--color-ink)] text-[var(--color-cream)] grain">
  <!-- subtle red wash -->
  <div aria-hidden="true" class="absolute -top-40 -right-40 h-[600px] w-[600px] rounded-full blur-3xl opacity-25"
    style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>

  <div class="container-x relative py-20 md:py-28 lg:py-32">
    <!-- top label row -->
    <div class="grid grid-cols-12 gap-6 mb-16">
      <div class="col-span-12 md:col-span-6 flex items-center gap-3">
        <span class="eyebrow text-[var(--color-rust)]">App 01 &nbsp;/&nbsp; {app.category}</span>
      </div>
      <div class="col-span-12 md:col-span-6 md:text-right">
        <span class="font-tamil text-lg text-[var(--color-cream)]/55">{app.tamilName}</span>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-y-8 md:gap-12 items-center">
      <!-- left: editorial -->
      <div class="col-span-12 lg:col-span-7 reveal">
        <h2 class="font-display text-[36px] sm:text-[56px] md:text-[72px] lg:text-[80px] leading-[1.0] tracking-[-0.02em]">
          {app.name}.<br/>
          <span class="italic font-[450] text-[var(--color-rust)]">{app.tagline}</span>
        </h2>

        <p class="mt-8 max-w-xl text-[17px] leading-[1.6] text-[var(--color-cream)]/75">
          {app.longDescription}
        </p>

        <ol class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-6 max-w-2xl">
          {app.features.map((f, i) => (
            <li class="border-t border-[var(--color-cream)]/15 pt-4">
              <span class="text-[var(--color-rust)] font-mono text-xs">F.0{i + 1}</span>
              <p class="font-medium text-[16px] mt-1.5">{f.title}</p>
              <p class="mt-1 text-[14px] text-[var(--color-cream)]/65 leading-relaxed">{f.body}</p>
            </li>
          ))}
        </ol>

        <div class="mt-10 flex flex-wrap gap-3 items-center">
          <a href={`/apps/${app.slug}`} class="btn bg-[var(--color-rust)] text-[var(--color-cream)] hover:bg-[var(--color-rust-deep)]">
            Open the {app.name} page
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#download" class="btn border border-[var(--color-cream)]/25 text-[var(--color-cream)] hover:bg-[var(--color-cream)]/10">
            Download
          </a>
          <VoteWidget slug={app.slug} accent="rust" variant="dark" />
        </div>
      </div>

      <!-- right: phone mockup - two-tab UI (Requests active, Resolved-to-Review bridge highlighted) -->
      <div class="col-span-12 lg:col-span-5 reveal">
        <div class="relative mx-auto max-w-[300px]">
          <!-- phone frame -->
          <div class="device relative bg-[#0a0a0a] p-3 rounded-[40px]">
            <div class="rounded-[28px] overflow-hidden bg-[var(--color-cream)] text-[var(--color-ink)] h-[580px] flex flex-col">
              <!-- status bar -->
              <div class="flex items-center justify-between px-5 py-2.5 text-[11px] font-medium">
                <span>9:41</span>
                <span class="flex items-center gap-1">
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-ink)]"></span>
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-ink)]"></span>
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-ink)]/30"></span>
                </span>
              </div>

              <!-- app header -->
              <div class="px-5 pt-2 pb-3 flex items-end justify-between">
                <div>
                  <p class="font-tamil text-[11px] text-[var(--color-ink)]/50">மக்கள் குரல்</p>
                  <h4 class="font-display text-[22px] leading-tight">Egmore · TN-15</h4>
                </div>
                <span class="rounded-full bg-[var(--color-cream-2)] px-2 py-0.5 text-[10px] font-mono text-[var(--color-ink)]/60">Anonymous</span>
              </div>

              <!-- tabs -->
              <div class="px-5 pb-1">
                <div class="flex items-center gap-1 border-b border-[var(--color-line)]">
                  <button class="relative px-3 py-2 text-[12px] font-semibold">
                    Whistles
                    <span class="absolute bottom-[-1px] left-1 right-1 h-[2px] bg-[var(--color-rust)] rounded-full"></span>
                  </button>
                  <button class="px-3 py-2 text-[12px] text-[var(--color-ink)]/45">Reviews</button>
                  <span class="ml-auto rounded-full bg-[color-mix(in_srgb,var(--color-rust)_14%,transparent)] text-[var(--color-rust-deep)] px-2 py-0.5 text-[10px] font-mono">3</span>
                </div>
              </div>

              <!-- whistles list -->
              <div class="px-3 pt-2.5 space-y-2 overflow-hidden">
                <!-- BRIDGE: resolved, awaiting review -->
                <div class="rounded-2xl border-2 border-[var(--color-rust)] bg-[color-mix(in_srgb,var(--color-rust)_8%,var(--color-cream))] p-3.5">
                  <div class="flex justify-between items-start">
                    <div>
                      <p class="text-[10.5px] uppercase tracking-wider text-[var(--color-rust)] font-bold flex items-center gap-1">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2l-3.5-3.6L4 14l5 5 11-11-1.5-1.5z"/></svg>
                        Resolved · Rate it
                      </p>
                      <p class="text-[13px] font-medium mt-0.5">Streetlight, 4th cross</p>
                    </div>
                    <span class="text-[10px] text-[var(--color-ink)]/50">2h ago</span>
                  </div>
                  <div class="mt-2.5 flex items-center gap-1">
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-rust)" stroke-width="1.5"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>
                    ))}
                    <span class="ml-1 text-[10px] text-[var(--color-ink)]/55">→ moves to Reviews</span>
                  </div>
                </div>

                <!-- in progress -->
                <div class="rounded-2xl bg-[var(--color-cream-2)] p-3.5">
                  <div class="flex justify-between items-start">
                    <div>
                      <p class="text-[10.5px] uppercase tracking-wider text-[var(--color-ink)]/55 font-semibold">In progress</p>
                      <p class="text-[13px] font-medium mt-0.5">Sub-registrar · EC delay</p>
                    </div>
                    <span class="text-[10px] text-[var(--color-ink)]/50">2d</span>
                  </div>
                  <div class="mt-3 h-1 rounded-full bg-[var(--color-cream-3)] overflow-hidden">
                    <div class="h-full w-2/3 bg-[var(--color-rust)]"></div>
                  </div>
                  <p class="mt-2 text-[10px] text-[var(--color-ink)]/55">Registration · auto-routed</p>
                </div>

                <!-- escalated -->
                <div class="rounded-2xl bg-[var(--color-cream-2)] p-3.5">
                  <div class="flex justify-between items-start">
                    <div>
                      <p class="text-[10.5px] uppercase tracking-wider text-amber-700 font-semibold">Escalated</p>
                      <p class="text-[13px] font-medium mt-0.5">Water connection delay</p>
                    </div>
                    <span class="text-[10px] text-[var(--color-ink)]/50">9d</span>
                  </div>
                  <p class="mt-2 text-[10px] text-[var(--color-ink)]/55">TWAD · raised to EE</p>
                </div>
              </div>

              <!-- whistle FAB - the primary "report a problem" CTA, styled as a whistle button -->
              <div class="mt-auto px-4 pb-5 pt-4">
                <button class="relative w-full rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] py-3.5 text-[13px] font-semibold flex items-center justify-center gap-2 shadow-[0_10px_30px_-8px_rgba(214,41,62,0.55)]">
                  <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <rect x="3" y="10.5" width="4" height="3" rx="0.5"/>
                    <path d="M7 9 H14 A4 4 0 0 1 14 17 H7 Z"/>
                    <circle cx="11.5" cy="13" r="1.3" fill="var(--color-rust)"/>
                    <circle cx="17.5" cy="7.5" r="1.2" fill="none" stroke="currentColor" stroke-width="1.2"/>
                  </svg>
                  <span>Whistle</span>
                </button>
              </div>
            </div>
          </div>

          <!-- floating callouts -->
          <div class="absolute -left-10 top-[30%] hidden md:block">
            <div class="rounded-xl bg-[var(--color-cream)] text-[var(--color-ink)] px-3 py-2 shadow-xl text-[11px] font-medium border border-[var(--color-line)]">
              <p class="text-[var(--color-rust)] text-[9.5px] uppercase tracking-wider">Resolved →</p>
              <p class="font-display text-[15px] leading-tight">flows to<br/>Reviews</p>
            </div>
          </div>

          <!-- whistle tagline callout, pointing to the Whistle CTA -->
          <div class="absolute -right-8 bottom-[34px] hidden md:flex items-center gap-1.5">
            <div class="rounded-xl bg-[var(--color-rust)] text-[var(--color-cream)] px-3 py-2.5 shadow-xl text-[11px] font-medium max-w-[150px]">
              <p class="text-[var(--color-cream)]/65 text-[9px] uppercase tracking-wider">The mantra</p>
              <p class="font-display text-[14px] leading-tight mt-0.5">If you have a problem,<br/>just whistle.</p>
            </div>
            <svg class="text-[var(--color-rust)] -mb-6 rotate-90" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M15 6l6 6-6 6"/></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- stats strip -->
    <div class="mt-20 md:mt-28 lg:mt-32 grid grid-cols-3 border-t border-[var(--color-cream)]/15">
      {app.stats.map((s) => (
        <div class="border-r last:border-r-0 border-[var(--color-cream)]/15 py-8 md:py-14 px-4 sm:px-6 first:pl-0">
          <p class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl tracking-[-0.02em] leading-none">{s.value}</p>
          <p class="text-[10px] sm:text-xs uppercase tracking-wider text-[var(--color-cream)]/55 mt-3 md:mt-5 leading-tight">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
