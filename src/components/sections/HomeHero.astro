---
const suite = [
  { anchor: 'makkal-kural', name: 'Makkal Kural', tamil: 'மக்கள் குரல்', category: 'Requests & reviews', accent: 'var(--color-rust)' },
  { anchor: 'whistle', name: 'Whistle', tamil: 'விசில்', category: 'Women safety', accent: 'var(--color-siren)' },
  { anchor: 'inout', name: 'InOut', tamil: 'உள்ளே வெளியே', category: 'TASMAC oversight', accent: 'var(--color-leaf)' },
  { anchor: 'docinout', name: 'DocInOut', tamil: 'டாக் வருகை', category: 'PHC + hospital oversight', accent: 'var(--color-pulse)' },
  { anchor: 'tut4neet', name: 'Tut4Neet', tamil: 'நீட் பயிற்சி', category: 'NEET prep', accent: 'var(--color-iris)' },
  { anchor: 'tn-eet', name: 'TN-EET', tamil: 'நுழைவுத் தேர்வு', category: 'Fair admissions', accent: 'var(--color-quill)' },
];
---
<section class="relative overflow-hidden pt-24 pb-20 md:pt-32 md:pb-24">
  <!-- decorative type column on the right edge -->
  <div aria-hidden="true" class="hidden lg:block absolute right-0 top-0 bottom-0 w-px bg-[var(--color-line)]"></div>
  <div aria-hidden="true" class="hidden lg:block absolute left-0 top-0 bottom-0 w-px bg-[var(--color-line)]"></div>

  <!-- soft red gradient blob -->
  <div aria-hidden="true" class="absolute -top-32 -right-32 h-[480px] w-[480px] rounded-full opacity-[0.35] blur-3xl"
    style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>
  <div aria-hidden="true" class="absolute -bottom-40 -left-20 h-[420px] w-[420px] rounded-full opacity-[0.22] blur-3xl"
    style="background: radial-gradient(closest-side, var(--color-gold), transparent 70%);"></div>

  <div class="container-x relative">
    <div class="flex items-center gap-3 mb-8 reveal">
      <span class="eyebrow text-[var(--color-ink)]/60">Tamil Nadu &nbsp;/&nbsp; 2026 &nbsp;/&nbsp; v1.0</span>
    </div>

    <h1 class="font-display text-[44px] leading-[1.02] sm:text-[64px] md:text-[88px] lg:text-[112px] tracking-[-0.02em] max-w-[12ch] reveal">
      Government that
      <span class="italic font-[450]">fits</span>
      in your pocket.
    </h1>

    <div class="mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-8 reveal">
      <p class="max-w-xl text-[17px] md:text-[19px] leading-[1.55] text-[var(--color-ink)]/75">
        A suite of six apps that re-imagines how 80 million Tamil Nadu citizens
        file requests, review government offices, call for help in a heartbeat, watch TASMAC shops in real time,
        hold PHC doctors accountable, and study for the biggest exam of their lives without coaching-centre prices. Tamil-first. Secure by design. No queues.
        <span class="block mt-3 text-[var(--color-rust)] font-display italic">If you have a problem, just whistle.</span>
      </p>

      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="#makkal-kural" class="btn btn-ink">
          See the apps
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
        <a href="#principles" class="btn btn-ghost">Our principles</a>
      </div>
    </div>

    <!-- suite index - the table of contents for the whole site -->
    <div id="suite" class="mt-16 md:mt-20 reveal scroll-mt-24">
      <div class="flex items-baseline justify-between mb-3">
        <span class="eyebrow text-[var(--color-ink)]/60">The suite</span>
        <span class="font-mono text-[11px] tracking-wide text-[var(--color-ink)]/45">06 apps &nbsp;·&nbsp; one suite</span>
      </div>
      <ol class="border-t border-[var(--color-line)]">
        {suite.map((s, i) => (
          <li class="border-b border-[var(--color-line)]">
            <a href={`#${s.anchor}`} class="suite-row group grid grid-cols-[2.25rem_1fr_auto] md:grid-cols-[3.5rem_1.1fr_1fr_auto] items-baseline gap-x-4 py-4 md:py-5" style={`--acc: ${s.accent}`}>
              <span class="font-mono text-xs text-[var(--color-ink)]/40 transition-colors group-hover:text-[var(--acc)]">0{i + 1}</span>
              <span class="flex min-w-0 items-baseline gap-3">
                <span class="suite-name font-display text-[22px] sm:text-2xl md:text-[28px] tracking-tight leading-tight">{s.name}</span>
                <span class="hidden sm:inline font-tamil text-sm text-[var(--color-ink)]/45 truncate">{s.tamil}</span>
              </span>
              <span class="hidden md:block text-sm text-[var(--color-ink)]/55">{s.category}</span>
              <span class="flex items-center gap-2.5 justify-self-end">
                <span class="h-2 w-2 rounded-full" style="background: var(--acc);"></span>
                <svg class="opacity-0 -translate-x-1 transition group-hover:opacity-100 group-hover:translate-x-0 text-[var(--acc)]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- marquee strip -->
  <div class="mt-16 border-y border-[var(--color-line)] overflow-hidden">
    <div class="flex whitespace-nowrap marquee py-5 text-[15px] font-display tracking-tight text-[var(--color-ink)]/55">
      {Array.from({ length: 2 }).map(() => (
        <div class="flex shrink-0 gap-10 pr-10">
          <span>Requests &amp; reviews</span><span class="text-[var(--color-rust)]">/</span>
          <span>Women safety</span><span style="color: var(--color-siren);">/</span>
          <span>TASMAC oversight</span><span class="text-[var(--color-leaf)]">/</span>
          <span>PHC accountability</span><span style="color: var(--color-pulse);">/</span>
          <span>NEET prep</span><span style="color: var(--color-iris);">/</span>
          <span>Fair admissions</span><span style="color: var(--color-quill);">/</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .suite-name {
    transition:
      color 0.25s ease,
      transform 0.3s var(--ease-out-quart);
  }
  .suite-row:hover .suite-name {
    color: var(--acc);
    transform: translateX(5px);
  }
</style>
