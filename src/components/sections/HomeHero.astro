---
---
<section class="relative overflow-hidden pt-24 pb-20 md:pt-32 md:pb-24">
  <!-- decorative type column on the right edge -->
  <div aria-hidden="true" class="hidden lg:block absolute right-0 top-0 bottom-0 w-px bg-[var(--color-line)]"></div>
  <div aria-hidden="true" class="hidden lg:block absolute left-0 top-0 bottom-0 w-px bg-[var(--color-line)]"></div>

  <!-- soft red gradient blob -->
  <div aria-hidden="true" class="absolute -top-32 -right-32 h-[480px] w-[480px] rounded-full opacity-[0.35] blur-3xl"
    style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>
  <div aria-hidden="true" class="absolute -bottom-40 -left-20 h-[420px] w-[420px] rounded-full opacity-[0.22] blur-3xl"
    style="background: radial-gradient(closest-side, var(--color-gold), transparent 70%);"></div>

  <div class="container-x relative">
    <div class="flex items-center gap-3 mb-8 reveal">
      <span class="eyebrow text-[var(--color-ink)]/60">Tamil Nadu &nbsp;/&nbsp; 2026 &nbsp;/&nbsp; v1.0</span>
    </div>

    <h1 class="font-display text-[44px] leading-[1.02] sm:text-[64px] md:text-[88px] lg:text-[112px] tracking-[-0.02em] max-w-[12ch] reveal">
      Government that
      <span class="italic font-[450]">fits</span>
      in your pocket.
    </h1>

    <div class="mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-8 reveal">
      <p class="max-w-xl text-[17px] md:text-[19px] leading-[1.55] text-[var(--color-ink)]/75">
        A suite of three apps - and a fourth, and a fifth on the way - that re-imagines how 80 million Tamil Nadu citizens
        access land records, raise grievances, and find every welfare scheme they're entitled to. Tamil-first.
        Open source. No queues.
      </p>

      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="#makkal-kural" class="btn btn-ink">
          See the apps
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
        <a href="#principles" class="btn btn-ghost">Our principles</a>
      </div>
    </div>

  </div>

  <!-- marquee strip -->
  <div class="mt-16 border-y border-[var(--color-line)] overflow-hidden">
    <div class="flex whitespace-nowrap marquee py-5 text-[15px] font-display tracking-tight text-[var(--color-ink)]/55">
      {Array.from({ length: 2 }).map(() => (
        <div class="flex shrink-0 gap-10 pr-10">
          <span>Citizen voice</span><span class="text-[var(--color-rust)]">/</span>
          <span>Land records</span><span class="text-[var(--color-leaf)]">/</span>
          <span>Welfare access</span><span class="text-[var(--color-gold)]">/</span>
          <span>Public health <span class="text-[var(--color-ink)]/30">(soon)</span></span><span class="text-[var(--color-ink)]/30">/</span>
          <span>Education <span class="text-[var(--color-ink)]/30">(soon)</span></span><span class="text-[var(--color-ink)]/30">/</span>
        </div>
      ))}
    </div>
  </div>
</section>
