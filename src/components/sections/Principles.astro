---
const principles = [
  {
    n: '01',
    title: 'Tamil-first, English-second',
    body: 'Every flow is designed and tested in Tamil first. English is the translation layer, not the default.',
  },
  {
    n: '02',
    title: 'Open by default',
    body: 'Our code, the rules we use to decide things, and our results are all public. Nothing hidden between you and the government.',
  },
  {
    n: '03',
    title: 'No queues, no agents',
    body: 'Everything finishes on your phone. If you really do have to visit a counter, the app tells you exactly why.',
  },
  {
    n: '04',
    title: 'Built for everyday phones',
    body: 'Each app is under 12MB, runs on Android 8, and still works on a slow connection. Built for the phones people actually carry, not the latest flagships.',
  },
];
---
<section id="principles" class="relative bg-[var(--color-ink)] text-[var(--color-cream)] py-24 md:py-32 overflow-hidden">
  <div aria-hidden="true" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[700px] w-[1100px] rounded-full blur-3xl opacity-10"
    style="background: radial-gradient(closest-side, var(--color-gold), transparent 70%);"></div>

  <div class="container-x relative">
    <div class="grid grid-cols-12 gap-y-10 md:gap-10">
      <div class="col-span-12 md:col-span-5">
        <span class="eyebrow text-[var(--color-cream)]/55">How we build</span>
        <h2 class="mt-4 font-display text-[36px] sm:text-[48px] md:text-[60px] lg:text-[68px] leading-[1.0] tracking-[-0.02em]">
          Four rules,<br/>
          <span class="italic font-[450] text-[var(--color-rust)]">no exceptions.</span>
        </h2>
        <p class="mt-6 text-[17px] leading-[1.55] text-[var(--color-cream)]/70 max-w-md">
          These aren't goals on a wall. Every app has to pass them before it ships under tvk/apps.
        </p>
      </div>
      <div class="col-span-12 md:col-span-7">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[var(--color-cream)]/12 rounded-2xl overflow-hidden">
          {principles.map((p) => (
            <li class="bg-[var(--color-ink)] p-7 md:p-8">
              <div class="font-mono text-[var(--color-rust)] text-xs">{p.n}</div>
              <h3 class="font-display text-2xl mt-4 tracking-tight">{p.title}</h3>
              <p class="mt-2 text-[14px] text-[var(--color-cream)]/65 leading-relaxed">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
