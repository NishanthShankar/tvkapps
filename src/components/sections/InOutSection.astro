---
import { getApp } from '../../data/apps';
const app = getApp('inout')!;
---
<section id="inout" class="relative overflow-hidden bg-[var(--color-cream)] py-20 md:py-28 lg:py-36">
  <div class="container-x">
    <div class="grid grid-cols-12 items-end gap-6 mb-16">
      <div class="col-span-12 md:col-span-6">
        <span class="eyebrow text-[var(--color-leaf)]">App 02 &nbsp;/&nbsp; {app.category}</span>
        <p class="mt-3 font-tamil text-2xl text-[var(--color-ink)]/60">{app.tamilName}</p>
      </div>
      <div class="col-span-12 md:col-span-6 md:text-right">
        <p class="text-sm text-[var(--color-ink)]/55 max-w-md md:ml-auto">
          Built around the mandate that every TASMAC shop opens and closes on the clock - and the public sees both.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-8 md:gap-16 items-start">
      <div class="col-span-12 lg:col-span-7 reveal">
        <h2 class="font-display text-[40px] sm:text-[56px] md:text-[72px] lg:text-[88px] leading-[1.0] tracking-[-0.02em]">
          {app.name}<br/>
          <span class="italic font-[450] text-[var(--color-leaf)]">{app.tagline}</span>
        </h2>

        <p class="mt-8 max-w-xl text-[17px] leading-[1.6] text-[var(--color-ink)]/75">
          {app.longDescription}
        </p>

        <div class="mt-12 flex flex-wrap gap-3">
          <a href={`/apps/${app.slug}`} class="btn bg-[var(--color-leaf)] text-[var(--color-cream)] hover:bg-[var(--color-leaf-deep)]">
            Open the {app.name} page
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#download" class="btn btn-ghost">Download</a>
        </div>
      </div>

      <!-- shop page mockup with late-close flag -->
      <div class="col-span-12 lg:col-span-5 reveal">
        <div class="relative">
          <div class="absolute inset-0 -rotate-1 rounded-[24px] bg-[var(--color-cream-3)]/60"></div>
          <article class="relative rounded-[24px] bg-white shadow-[0_40px_80px_-30px_rgba(14,14,14,0.25)] border border-[var(--color-line)] overflow-hidden">
            <!-- status banner -->
            <div class="bg-[color-mix(in_srgb,var(--color-rust)_12%,white)] border-b border-[var(--color-line)] px-5 py-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="relative flex">
                  <span class="absolute h-2 w-2 rounded-full bg-[var(--color-rust)] opacity-60 animate-ping"></span>
                  <span class="relative h-2 w-2 rounded-full bg-[var(--color-rust)]"></span>
                </span>
                <span class="text-[11px] uppercase tracking-wider text-[var(--color-rust-deep)] font-semibold">Still open &middot; 22 min late</span>
              </div>
              <span class="font-mono text-[10.5px] text-[var(--color-ink)]/55">10:22 PM</span>
            </div>

            <!-- shop header -->
            <div class="p-5 border-b border-[var(--color-line)]">
              <p class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/50">TASMAC &middot; #3417</p>
              <p class="font-display text-2xl tracking-tight mt-0.5">Anna Nagar West</p>
              <p class="text-[11px] text-[var(--color-ink)]/55 mt-1">Anna Nagar &middot; TN-03</p>
            </div>

            <!-- today's log -->
            <div class="p-5">
              <p class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/50 mb-3">Today</p>
              <ol class="relative space-y-3">
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-[var(--color-leaf)] shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium">Checked in</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">12:00 PM &middot; selfie + GPS verified</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-amber-500 shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium">Complaint filed</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">4:30 PM &middot; underage sale</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-[var(--color-ink)]/40 shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium text-[var(--color-ink)]/65">Mandatory close</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">10:00 PM</p>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 rounded-full bg-[var(--color-rust)] shrink-0"></span>
                  <div class="flex-1">
                    <p class="text-[12.5px] font-medium text-[var(--color-rust-deep)]">Flagged: still open</p>
                    <p class="text-[11px] text-[var(--color-ink)]/55">10:15 PM &middot; inspector notified</p>
                  </div>
                </li>
              </ol>
            </div>

            <!-- footer -->
            <div class="border-t border-[var(--color-line)] px-5 py-4 flex items-center justify-between">
              <span class="text-[11px] text-[var(--color-ink)]/55">28 / 30 days closed on time</span>
              <button class="text-[11.5px] font-medium text-[var(--color-rust-deep)]">Report issue &rarr;</button>
            </div>
          </article>
        </div>
      </div>
    </div>

    <!-- feature pillars -->
    <div class="mt-24 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-line)] rounded-2xl overflow-hidden border border-[var(--color-line)]">
      {app.features.map((f, i) => (
        <div class="bg-[var(--color-cream)] p-7">
          <div class="flex items-center gap-2 mb-6">
            <span class="font-mono text-[11px] text-[var(--color-leaf)]">F.0{i + 1}</span>
            <span class="h-px flex-1 bg-[var(--color-line)]"></span>
          </div>
          <h3 class="font-display text-xl tracking-tight">{f.title}</h3>
          <p class="mt-2 text-[14px] text-[var(--color-ink)]/65 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- stats inline -->
    <div class="mt-12 flex flex-wrap items-baseline gap-x-12 gap-y-4">
      {app.stats.map((s) => (
        <div class="flex items-baseline gap-3">
          <span class="font-display text-3xl tracking-tight text-[var(--color-leaf)]">{s.value}</span>
          <span class="text-xs uppercase tracking-wider text-[var(--color-ink)]/55">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
