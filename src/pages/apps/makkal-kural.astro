---
import Base from '../../layouts/Base.astro';
import { apps, getApp } from '../../data/apps';

const app = getApp('makkal-kural')!;
const others = apps.filter((a) => a.slug !== app.slug);

const sampleReviews = [
  {
    snippet:
      'The arasu marundhagam in Tiruvanmiyur was out of metformin for three days running. Pharmacist had no idea when restock would happen.',
    rating: 1,
    constituency: 'Mylapore · TN-25',
    department: 'Health',
    office: 'TNMSC Tiruvanmiyur',
    service: 'Drug availability',
    when: '12m ago',
    source: 'direct' as const,
  },
  {
    snippet:
      'Streetlight on 4th cross fixed within 6 hours after the request - very fast turnaround by the AE.',
    rating: 5,
    constituency: 'Egmore · TN-15',
    department: 'TANGEDCO',
    office: 'Ward 17',
    service: 'Streetlight repair',
    when: '1h ago',
    source: 'request' as const,
    requestId: '#1284',
  },
  {
    snippet:
      "We've been trying to update my mother's patta after her transfer last month - four trips to the taluk office and still no movement.",
    rating: 2,
    constituency: 'Mylapore · TN-25',
    department: 'Revenue',
    office: 'Mylapore Taluk',
    service: 'Patta mutation',
    when: '3h ago',
    source: 'direct' as const,
  },
  {
    snippet:
      'Water connection promised in 30 days, took 94. After two escalations through the app the EE finally cleared it.',
    rating: 3,
    constituency: 'Coimbatore South · TN-100',
    department: 'TWAD',
    office: 'CMC Zone 4',
    service: 'New water connection',
    when: '5h ago',
    source: 'request' as const,
    requestId: '#0911',
  },
];

const leaderboard = [
  { constituency: 'Mylapore · TN-25', dept: 'Revenue', score: 1.8, n: 412 },
  { constituency: 'Egmore · TN-15', dept: 'Registration', score: 1.9, n: 287 },
  { constituency: 'T. Nagar · TN-22', dept: 'TN Electricity', score: 2.1, n: 198 },
  { constituency: 'Coimbatore North · TN-99', dept: 'TN Water Supply', score: 2.2, n: 156 },
];

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  alternateName: app.tamilName,
  description: app.shortDescription,
  applicationCategory: app.category,
  operatingSystem: 'Android, iOS, Web',
  inLanguage: ['ta', 'en'],
};

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: app.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title={app.meta.title}
  description={app.meta.description}
  keywords={app.meta.keywords}
  type="article"
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-[var(--color-ink)] text-[var(--color-cream)] grain">
    <div aria-hidden="true" class="absolute -top-40 -right-40 h-[700px] w-[700px] rounded-full blur-3xl opacity-30"
      style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>
    <div aria-hidden="true" class="absolute -bottom-32 -left-32 h-[460px] w-[460px] rounded-full blur-3xl opacity-15"
      style="background: radial-gradient(closest-side, var(--color-gold), transparent 70%);"></div>

    <div class="container-x relative pt-20 pb-24 md:pt-28 md:pb-32">
      <nav class="text-xs text-[var(--color-cream)]/55 mb-12">
        <a href="/" class="hover:text-[var(--color-cream)]">tvkapps</a>
        <span class="mx-2 opacity-50">/</span>
        <a href="/#suite" class="hover:text-[var(--color-cream)]">apps</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-[var(--color-cream)]/85">Makkal Kural</span>
      </nav>

      <div class="grid grid-cols-12 gap-8 items-end">
        <div class="col-span-12 lg:col-span-8">
          <span class="eyebrow text-[var(--color-rust)]">{app.category} &nbsp;/&nbsp; App 01</span>
          <div class="mt-4 flex items-end gap-5 flex-wrap">
            <h1 class="font-display text-[64px] sm:text-[96px] md:text-[128px] leading-[0.92] tracking-[-0.025em]">
              Makkal<br/>Kural.
            </h1>
            <span class="font-tamil text-3xl md:text-4xl text-[var(--color-cream)]/55 pb-4">{app.tamilName}</span>
          </div>
          <p class="mt-6 font-display text-2xl md:text-4xl italic font-[450] text-[var(--color-rust)] max-w-2xl">
            {app.tagline}
          </p>
        </div>
        <div class="col-span-12 lg:col-span-4 flex flex-wrap gap-3 lg:justify-end">
          <a href="#download" class="btn bg-[var(--color-rust)] text-[var(--color-cream)] hover:bg-[var(--color-rust-deep)]">
            Get the app
          </a>
          <a href="/" class="btn border border-[var(--color-cream)]/25 text-[var(--color-cream)] hover:bg-[var(--color-cream)]/10">
            All apps
          </a>
        </div>
      </div>

      <p class="mt-12 max-w-3xl text-[18px] md:text-[20px] leading-[1.55] text-[var(--color-cream)]/75">
        {app.longDescription}
      </p>

      <!-- platform badges -->
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <span class="text-xs uppercase tracking-wider text-[var(--color-cream)]/50">Available on</span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-cream)]/8 border border-[var(--color-cream)]/15 px-3 py-1.5 text-[12px] font-medium">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16v2H4zm0 5h16v6H4zm0 9h10v2H4z"/></svg>
          Web
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-cream)]/8 border border-[var(--color-cream)]/15 px-3 py-1.5 text-[12px] font-medium">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5V3.5a1 1 0 0 1 1.5-.87l15 8.5a1 1 0 0 1 0 1.74l-15 8.5A1 1 0 0 1 3 20.5z"/></svg>
          Android
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-cream)]/8 border border-[var(--color-cream)]/15 px-3 py-1.5 text-[12px] font-medium">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 12.5a4.5 4.5 0 0 1 2.5-4 4.5 4.5 0 0 0-3.5-2c-1.5 0-2.5 1-4 1s-2.5-1-4-1c-2.5 0-5 2-5 6.5C3.5 16.5 6 22 9 22c1 0 2-1 3.5-1s2.5 1 3.5 1c1 0 2-2 3-4-1.5-1-2.5-3-1.5-5.5z"/></svg>
          iOS
        </span>
      </div>

      <!-- stats strip -->
      <div class="mt-16 grid grid-cols-3 border-t border-[var(--color-cream)]/15">
        {app.stats.map((s) => (
          <div class="border-r last:border-r-0 border-[var(--color-cream)]/15 py-7 pr-6">
            <p class="font-display text-3xl md:text-5xl tracking-[-0.02em] text-[var(--color-rust)]">{s.value}</p>
            <p class="text-xs uppercase tracking-wider text-[var(--color-cream)]/55 mt-2">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TWO TABS: REQUESTS & REVIEWS -->
  <section class="relative bg-[var(--color-cream)] py-24 md:py-32">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-10 items-end mb-14">
        <div class="col-span-12 md:col-span-7">
          <span class="eyebrow text-[var(--color-rust)]">The model</span>
          <h2 class="mt-3 font-display text-[40px] md:text-[64px] leading-[1.0] tracking-[-0.02em] max-w-3xl">
            Two tabs.<br/>
            <span class="italic font-[450]">One public ledger.</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-5">
          <p class="text-[15px] text-[var(--color-ink)]/70 max-w-md">
            File a request when something is broken. Leave a review when something is done. The bridge between them is the
            interesting part - resolved requests roll into reviews, so the public record shows the whole arc.
          </p>
        </div>
      </div>

      <div class="relative grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] gap-6 items-stretch">
        <!-- REQUESTS TAB -->
        <article class="rounded-[28px] bg-[var(--color-cream-2)] border border-[var(--color-line)] p-8 md:p-10 relative">
          <div class="flex items-center justify-between mb-6">
            <span class="rounded-full bg-[var(--color-ink)] text-[var(--color-cream)] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider">Tab · Requests</span>
            <span class="font-mono text-[11px] text-[var(--color-ink)]/45">When it’s broken</span>
          </div>
          <h3 class="font-display text-3xl tracking-tight">File. Route. Track.</h3>
          <p class="mt-3 text-[14.5px] text-[var(--color-ink)]/70 leading-relaxed">
            A streetlight that hasn’t worked for a week. A patta mutation stuck for a month. A water connection
            promised in 30 days, missed by 90. Write it once - the app routes it to the right department by
            location and text, and tracks every officer action until it’s closed.
          </p>

          <!-- mini list -->
          <ul class="mt-7 space-y-2.5">
            <li class="rounded-xl bg-[var(--color-cream)] border border-[var(--color-line)] p-3.5 flex items-center justify-between">
              <div>
                <p class="text-[10.5px] uppercase tracking-wider text-[var(--color-ink)]/50 font-semibold">In progress</p>
                <p class="text-[13.5px] font-medium mt-0.5">Sub-registrar EC delay</p>
              </div>
              <div class="h-1 w-12 bg-[var(--color-cream-3)] rounded-full overflow-hidden">
                <div class="h-full w-2/3 bg-[var(--color-rust)]"></div>
              </div>
            </li>
            <li class="rounded-xl bg-[var(--color-cream)] border border-[var(--color-line)] p-3.5">
              <p class="text-[10.5px] uppercase tracking-wider text-amber-700 font-semibold">Escalated</p>
              <p class="text-[13.5px] font-medium mt-0.5">Water connection delay</p>
              <p class="text-[11px] text-[var(--color-ink)]/55 mt-1">TWAD · raised to EE on day 9</p>
            </li>
          </ul>

          <ul class="mt-7 space-y-2 text-[13px] text-[var(--color-ink)]/70">
            <li class="flex items-center gap-2"><span class="text-[var(--color-rust)] font-mono text-[11px]">F.01</span> Auto-routed to the right office</li>
            <li class="flex items-center gap-2"><span class="text-[var(--color-rust)] font-mono text-[11px]">F.02</span> Live status with timestamped actions</li>
            <li class="flex items-center gap-2"><span class="text-[var(--color-rust)] font-mono text-[11px]">F.03</span> Auto-escalates after SLA</li>
          </ul>
        </article>

        <!-- BRIDGE / FLOW -->
        <div class="flex lg:flex-col items-center justify-center gap-3 lg:py-10">
          <!-- arrow + label -->
          <div class="flex lg:flex-col items-center gap-2">
            <div class="hidden lg:flex flex-col items-center">
              <svg width="22" height="120" viewBox="0 0 22 120" fill="none" stroke="var(--color-rust)" stroke-width="1.5" stroke-dasharray="3 5">
                <path d="M11 0 L11 110"/>
                <path d="M5 102 L11 114 L17 102" stroke-dasharray="0"/>
              </svg>
              <span class="rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] px-3 py-1.5 text-[10.5px] font-mono uppercase tracking-wider">Resolved + rated</span>
              <svg width="22" height="120" viewBox="0 0 22 120" fill="none" stroke="var(--color-ink)" stroke-opacity="0.25" stroke-width="1.5" stroke-dasharray="3 5">
                <path d="M11 18 L11 120"/>
                <path d="M5 26 L11 14 L17 26" stroke-dasharray="0"/>
              </svg>
            </div>
            <!-- mobile horizontal version -->
            <div class="flex lg:hidden flex-col items-center gap-2">
              <span class="rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] px-3 py-1.5 text-[10.5px] font-mono uppercase tracking-wider">Resolved + rated flows to reviews</span>
            </div>
          </div>
        </div>

        <!-- REVIEWS TAB -->
        <article class="rounded-[28px] bg-[var(--color-ink)] text-[var(--color-cream)] p-8 md:p-10 relative overflow-hidden">
          <div aria-hidden="true" class="absolute -top-20 -right-20 h-[280px] w-[280px] rounded-full blur-3xl opacity-30"
            style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-6">
              <span class="rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider">Tab · Reviews</span>
              <span class="font-mono text-[11px] text-[var(--color-cream)]/50">When it’s done</span>
            </div>
            <h3 class="font-display text-3xl tracking-tight">Rate. Aggregate. Publish.</h3>
            <p class="mt-3 text-[14.5px] text-[var(--color-cream)]/75 leading-relaxed">
              Post a review directly after a counter visit, or attach one when a request closes. Each review carries a
              star rating, the auto-detected office and department, and a snippet. Aggregates feed the public leaderboard
              by office, by department, by constituency.
            </p>

            <!-- mini list -->
            <ul class="mt-7 space-y-2.5">
              <li class="rounded-xl bg-[var(--color-cream)]/8 border border-[var(--color-cream)]/12 p-3.5">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1">
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--color-rust)"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>
                    ))}
                  </div>
                  <span class="text-[10px] text-[var(--color-cream)]/55">from Request #1284</span>
                </div>
                <p class="text-[12.5px] mt-2 text-[var(--color-cream)]/85">Streetlight on 4th cross fixed within 6 hours - very fast turnaround.</p>
              </li>
              <li class="rounded-xl bg-[var(--color-cream)]/8 border border-[var(--color-cream)]/12 p-3.5">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="var(--color-rust)"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>
                    {Array.from({ length: 4 }).map(() => (
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--color-cream)" stroke-opacity="0.35" stroke-width="1.5"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg>
                    ))}
                  </div>
                  <span class="text-[10px] text-[var(--color-cream)]/55">direct review</span>
                </div>
                <p class="text-[12.5px] mt-2 text-[var(--color-cream)]/85">Sub-registrar in Egmore. 3 hours for an EC. Documents asked twice.</p>
              </li>
            </ul>

            <ul class="mt-7 space-y-2 text-[13px] text-[var(--color-cream)]/75">
              <li class="flex items-center gap-2"><span class="text-[var(--color-rust)] font-mono text-[11px]">F.01</span> 1-5 star + free text + photo</li>
              <li class="flex items-center gap-2"><span class="text-[var(--color-rust)] font-mono text-[11px]">F.02</span> Aggregated rankings, open data</li>
              <li class="flex items-center gap-2"><span class="text-[var(--color-rust)] font-mono text-[11px]">F.03</span> One source of truth, two entry points</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS - the two crux mechanics -->
  <section class="relative bg-[var(--color-cream-2)] py-24 md:py-32">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-10 items-end mb-16">
        <div class="col-span-12 md:col-span-7">
          <span class="eyebrow text-[var(--color-rust)]">How both tabs work</span>
          <h2 class="mt-3 font-display text-[40px] md:text-[64px] leading-[1.0] tracking-[-0.02em] max-w-3xl">
            Two pieces of intelligence,<br/>
            <span class="italic font-[450]">one frictionless post.</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-5">
          <p class="text-[15px] text-[var(--color-ink)]/70 max-w-md">
            Whether you’re filing a request or leaving a review, you never pick from a menu of 240 departments or scroll
            a list of every government office in the state. We figure it out from where you are and what you wrote.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- LEFT: location → constituency -->
        <article class="relative rounded-[28px] overflow-hidden bg-[var(--color-cream-2)] border border-[var(--color-line)] p-8 md:p-10">
          <div class="flex items-start justify-between mb-8">
            <div>
              <p class="font-mono text-[11px] text-[var(--color-rust)] mb-2">01 · LOCATE</p>
              <h3 class="font-display text-3xl tracking-tight">Location finds your constituency.</h3>
            </div>
          </div>

          <!-- abstract TN constituency grid map -->
          <div class="relative rounded-2xl bg-[var(--color-cream)] border border-[var(--color-line)] p-6 overflow-hidden">
            <svg viewBox="0 0 360 220" class="w-full h-auto" preserveAspectRatio="xMidYMid meet">
              <!-- abstract grid of "constituencies" -->
              {Array.from({ length: 18 }).map((_, col) =>
                Array.from({ length: 11 }).map((_, row) => {
                  const cx = 20 + col * 19;
                  const cy = 12 + row * 18;
                  const isHi = col === 10 && row === 5;
                  const isNb = (col === 9 && row === 5) || (col === 11 && row === 5) || (col === 10 && row === 4) || (col === 10 && row === 6);
                  return (
                    <rect
                      x={cx}
                      y={cy}
                      width="14"
                      height="14"
                      rx="2"
                      fill={isHi ? 'var(--color-rust)' : isNb ? 'color-mix(in srgb, var(--color-rust) 22%, transparent)' : 'color-mix(in srgb, var(--color-ink) 6%, transparent)'}
                    />
                  );
                })
              )}
              <!-- pulse ring -->
              <circle cx="217" cy="109" r="14" fill="none" stroke="var(--color-rust)" stroke-width="1.5" opacity="0.5">
                <animate attributeName="r" from="10" to="22" dur="1.8s" repeatCount="indefinite"/>
                <animate attributeName="opacity" from="0.55" to="0" dur="1.8s" repeatCount="indefinite"/>
              </circle>
            </svg>

            <div class="mt-6 flex items-center justify-between">
              <div>
                <p class="text-[11px] uppercase tracking-wider text-[var(--color-ink)]/50">Detected constituency</p>
                <p class="font-display text-xl mt-0.5">Egmore</p>
              </div>
              <span class="rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] px-3 py-1.5 text-xs font-mono">TN-15</span>
            </div>
          </div>

          <ul class="mt-6 space-y-2.5 text-[13.5px] text-[var(--color-ink)]/75">
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-rust)" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
              Coarse network geolocation, accurate to ~2 km. Never your street.
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-rust)" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
              Maps you to one of 234 assembly constituencies.
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-rust)" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
              Override manually if you're reviewing an office in a different ward.
            </li>
          </ul>
        </article>

        <!-- RIGHT: text → department -->
        <article class="relative rounded-[28px] overflow-hidden bg-[var(--color-cream-2)] border border-[var(--color-line)] p-8 md:p-10">
          <div class="flex items-start justify-between mb-8">
            <div>
              <p class="font-mono text-[11px] text-[var(--color-rust)] mb-2">02 · CLASSIFY</p>
              <h3 class="font-display text-3xl tracking-tight">Text finds the department.</h3>
            </div>
          </div>

          <!-- text excerpt with highlighted spans -->
          <div class="relative rounded-2xl bg-[var(--color-cream)] border border-[var(--color-line)] p-5">
            <p class="text-[14px] leading-[1.6] text-[var(--color-ink)]/85">
              Went to the <span class="rounded px-1 py-0.5 bg-[color-mix(in_srgb,var(--color-rust)_18%,transparent)] text-[var(--color-rust-deep)] font-medium">sub-registrar's office</span> in
              <span class="rounded px-1 py-0.5 bg-[color-mix(in_srgb,var(--color-gold)_22%,transparent)] text-[var(--color-gold-deep)] font-medium">Egmore</span> today
              for an <span class="rounded px-1 py-0.5 bg-[color-mix(in_srgb,var(--color-leaf)_18%,transparent)] text-[var(--color-leaf-deep)] font-medium">EC</span>.
              Waited 3 hours and they kept asking for documents I'd already submitted online.
            </p>
          </div>

          <!-- arrows + chips -->
          <div class="mt-5 space-y-2">
            <div class="flex items-center gap-3">
              <span class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/45 w-16">Office</span>
              <span class="h-px flex-1 bg-[var(--color-line)]"></span>
              <span class="rounded-full bg-[color-mix(in_srgb,var(--color-rust)_15%,transparent)] text-[var(--color-rust-deep)] px-3 py-1 text-[11.5px] font-medium">Sub-Registrar, Egmore</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/45 w-16">Dept</span>
              <span class="h-px flex-1 bg-[var(--color-line)]"></span>
              <span class="rounded-full bg-[color-mix(in_srgb,var(--color-rust)_15%,transparent)] text-[var(--color-rust-deep)] px-3 py-1 text-[11.5px] font-medium">Registration</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/45 w-16">Service</span>
              <span class="h-px flex-1 bg-[var(--color-line)]"></span>
              <span class="rounded-full bg-[color-mix(in_srgb,var(--color-rust)_15%,transparent)] text-[var(--color-rust-deep)] px-3 py-1 text-[11.5px] font-medium">Encumbrance Certificate</span>
            </div>
          </div>

          <ul class="mt-6 space-y-2.5 text-[13.5px] text-[var(--color-ink)]/75">
            <li class="flex items-start gap-2">
