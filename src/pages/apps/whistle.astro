          {[
            { v: 'SP-112', loc: 'T. Nagar South', status: 'Responding · W-04 821', tone: 'rust', t: '3 m ago' },
            { v: 'SP-238', loc: 'Anna Nagar', status: 'On route to alert', tone: 'rust', t: '1 m ago' },
            { v: 'SP-067', loc: 'Mylapore', status: 'Patrolling', tone: 'siren', t: 'now' },
            { v: 'SP-301', loc: 'Egmore', status: 'Idle &middot; 28 min', tone: 'amber', t: '5 m ago' },
            { v: 'SP-194', loc: 'Adyar', status: 'Off-route 1.8 km', tone: 'amber', t: '2 m ago' },
          ].map((row) => (
            <li class="px-5 py-3">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2 min-w-0 flex-1">
                  <span class="h-2 w-2 rounded-full shrink-0"
                    style={`background: ${row.tone === 'rust' ? 'var(--color-rust)' : row.tone === 'siren' ? 'var(--color-siren)' : 'rgb(217,119,6)'};`}></span>
                  <span class="font-mono text-[11px] text-[var(--color-cream)]/55 shrink-0">{row.v}</span>
                  <span class="font-medium text-[12.5px] truncate">{row.loc}</span>
                </div>
                <span class="font-mono text-[10.5px] text-[var(--color-cream)]/45 shrink-0">{row.t}</span>
              </div>
              <p class="mt-1 ml-[18px] text-[11px] text-[var(--color-cream)]/65" set:html={row.status}></p>
            </li>
