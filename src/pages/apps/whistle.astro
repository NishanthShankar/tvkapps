      <!-- dashboard mock row -->
      <div class="mt-12 rounded-2xl bg-[var(--color-cream)]/6 border border-[var(--color-cream)]/12 overflow-hidden">
        <div class="px-5 py-3 border-b border-[var(--color-cream)]/12 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <p class="text-[10px] uppercase tracking-wider text-[var(--color-cream)]/50">Singa Pen oversight &middot; live</p>
            <p class="font-display text-base">Chennai zone &middot; 14:02</p>
