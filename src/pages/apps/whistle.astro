      <div class="mt-10 flex flex-wrap items-center gap-3 text-[13px] text-[var(--color-ink)]/70">
        <span class="text-[var(--color-ink)]/55">Accepted IDs:</span>
        {['Aadhaar', 'PAN', 'TN Citizenship Card', 'School / College ID'].map((id) => (
          <span class="rounded-full bg-[var(--color-cream-2)] border border-[var(--color-line)] px-3 py-1.5 font-medium">{id}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="bg-[var(--color-cream-2)] py-24 md:py-32">
