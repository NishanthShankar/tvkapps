---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { apps, getApp } from '../../data/apps';

const app = getApp('whistle')!;
const others = apps.filter((a) => a.slug !== app.slug);

const recipients = [
  {
    n: '01',
    title: 'Emergency contacts',
    body: 'SMS + WhatsApp message with your live location to every contact on file. They can see you on a map and ping back.',
    detail: 'Up to 5 contacts',
    tone: 'cream' as const,
  },
  {
    n: '02',
    title: 'Local police',
    body: 'The nearest police station for your current location is notified with route, shift on duty, and a callback line.',
    detail: 'Routed by current GPS',
    tone: 'cream' as const,
  },
  {
    n: '03',
    title: 'Nearest Singa Pen patrol',
    body: 'The patrol app inside the closest Singa Pen vehicle gets the alert with route. They confirm en route within seconds.',
    detail: 'Median arrival <4 min',
    tone: 'siren' as const,
  },
];

const anomalies = [
  {
    code: 'A.01',
    label: 'Vehicle idle > 25 min',
    body: 'Patrol parked beyond standard tea-break window during active hours.',
    chip: 'Flag',
    tone: 'amber',
  },
  {
    code: 'A.02',
    label: 'Off-route',
    body: 'Vehicle outside assigned patrol perimeter by more than 1.5 km.',
    chip: 'Investigate',
    tone: 'rust',
  },
  {
    code: 'A.03',
    label: 'Responding to alert',
    body: 'Vehicle is en route to a Whistle alarm. Shown live until cleared.',
    chip: 'Live',
    tone: 'leaf',
  },
  {
    code: 'A.04',
    label: 'Officer signal lost',
    body: "Patrol app heartbeat stopped while vehicle still moving. Could mean officer is on foot.",
    chip: 'Verify',
    tone: 'amber',
  },
];

const verificationSteps = [
  {
    n: '01',
    title: 'Live face video',
    body: 'A short head-turn video to prove a real person, in real time, in front of the camera.',
  },
  {
    n: '02',
    title: 'Photo ID',
    body: 'Upload one of: Aadhaar, PAN, the TN Citizenship Card (when issued), or a current school / college ID.',
  },
  {
    n: '03',
    title: 'Match + discard',
    body: 'The ID image is matched against the face video. Only the match hash is kept - the document itself is discarded.',
  },
];

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  alternateName: app.tamilName,
  description: app.shortDescription,
  applicationCategory: app.category,
  operatingSystem: 'Android, iOS, Web',
  inLanguage: ['ta', 'en'],
};

const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: app.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title={app.meta.title}
  description={app.meta.description}
  keywords={app.meta.keywords}
  type="article"
>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-[var(--color-ink)] text-[var(--color-cream)] grain">
    <div aria-hidden="true" class="absolute -top-40 -right-40 h-[700px] w-[700px] rounded-full blur-3xl opacity-25"
      style="background: radial-gradient(closest-side, var(--color-siren), transparent 70%);"></div>
    <div aria-hidden="true" class="absolute -bottom-40 -left-32 h-[460px] w-[460px] rounded-full blur-3xl opacity-15"
      style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>

    <div class="container-x relative pt-20 pb-24 md:pt-28 md:pb-32">
      <nav class="text-xs text-[var(--color-cream)]/55 mb-12">
        <a href="/" class="hover:text-[var(--color-cream)]">tvkapps</a>
        <span class="mx-2 opacity-50">/</span>
        <a href="/#suite" class="hover:text-[var(--color-cream)]">apps</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-[var(--color-cream)]/85">Whistle</span>
      </nav>

      <div class="grid grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="col-span-12 lg:col-span-8">
          <span class="eyebrow" style="color: color-mix(in srgb, var(--color-siren) 80%, white);">{app.category} &nbsp;/&nbsp; App 04</span>
          <div class="mt-4 flex items-end gap-3 sm:gap-5 flex-wrap">
            <h1 class="font-display text-[48px] sm:text-[80px] md:text-[112px] lg:text-[128px] leading-[0.92] tracking-[-0.025em]">
              Whistle.
            </h1>
            <span class="font-tamil text-xl sm:text-3xl md:text-4xl text-[var(--color-cream)]/55 pb-2 sm:pb-4">{app.tamilName}</span>
          </div>
          <p class="mt-6 font-display text-xl sm:text-2xl md:text-4xl italic font-[450] max-w-2xl"
            style="color: color-mix(in srgb, var(--color-siren) 70%, white);">
            {app.tagline}
          </p>
          <p class="mt-3 text-[12px] sm:text-[13px] font-mono uppercase tracking-[0.2em] text-[var(--color-rust)]">
            &mdash;&nbsp; If you have a problem, just whistle.
          </p>
        </div>
        <div class="col-span-12 lg:col-span-4 flex flex-wrap gap-3 lg:justify-end">
          <a href="#download" class="btn bg-[var(--color-siren)] text-[var(--color-cream)] hover:bg-[var(--color-siren-deep)]">
            Get the app
          </a>
          <a href="/" class="btn border border-[var(--color-cream)]/25 text-[var(--color-cream)] hover:bg-[var(--color-cream)]/10">
            All apps
          </a>
        </div>
      </div>

      <p class="mt-10 md:mt-12 max-w-3xl text-[16px] sm:text-[18px] md:text-[20px] leading-[1.55] text-[var(--color-cream)]/75">
        {app.longDescription}
      </p>

      <!-- stats strip -->
      <div class="mt-16 md:mt-20 grid grid-cols-3 border-t border-[var(--color-cream)]/15">
        {app.stats.map((s) => (
          <div class="border-r last:border-r-0 border-[var(--color-cream)]/15 py-8 md:py-12 px-4 sm:px-6 first:pl-0">
            <p class="font-display text-2xl sm:text-3xl md:text-5xl lg:text-6xl tracking-[-0.02em] leading-none"
              style="color: color-mix(in srgb, var(--color-siren) 75%, white);">{s.value}</p>
            <p class="text-[10px] sm:text-xs uppercase tracking-wider text-[var(--color-cream)]/55 mt-3 md:mt-5 leading-tight">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE SOS BUTTON + RECIPIENTS -->
  <section class="bg-[var(--color-cream)] py-24 md:py-32 relative overflow-hidden">
    <div aria-hidden="true" class="absolute -top-32 -right-20 h-[460px] w-[460px] rounded-full blur-3xl opacity-15"
      style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>

    <div class="container-x relative">
      <div class="grid grid-cols-12 gap-y-10 md:gap-10 items-end mb-14 md:mb-16">
        <div class="col-span-12 md:col-span-7">
          <span class="eyebrow text-[var(--color-rust)]">The button</span>
          <h2 class="mt-3 font-display text-[36px] sm:text-[56px] md:text-[64px] leading-[1.0] tracking-[-0.02em] max-w-3xl">
            One tap.<br/>
            <span class="italic font-[450]">Three responders.</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-5">
          <p class="text-[15px] text-[var(--color-ink)]/70 max-w-md leading-relaxed">
            A homescreen shortcut. Pressed in panic or after a long uneasy walk. The moment your thumb lifts, three
            separate alerts go out in parallel - and the phone starts whistling at full volume.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-8 items-stretch">
        <!-- SOS button rendering -->
        <article class="rounded-[28px] bg-[var(--color-ink)] text-[var(--color-cream)] p-8 md:p-12 relative overflow-hidden grid place-items-center min-h-[420px]">
          <div aria-hidden="true" class="absolute inset-0"
            style="background: radial-gradient(circle at 50% 55%, color-mix(in srgb, var(--color-rust) 18%, transparent), transparent 65%);"></div>

          <div class="relative flex flex-col items-center text-center">
            <div class="relative grid place-items-center">
              <span aria-hidden="true" class="absolute h-[280px] w-[280px] rounded-full border border-[var(--color-rust)] opacity-15 animate-ping" style="animation-duration: 2.6s;"></span>
              <span aria-hidden="true" class="absolute h-[230px] w-[230px] rounded-full border border-[var(--color-rust)] opacity-25"></span>
              <span aria-hidden="true" class="absolute h-[190px] w-[190px] rounded-full border-2 border-[var(--color-rust)] opacity-40"></span>
              <button class="relative h-[160px] w-[160px] rounded-full text-[var(--color-cream)] shadow-[0_30px_80px_-20px_rgba(214,41,62,0.6)]"
                style="background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--color-rust) 80%, white), var(--color-rust) 55%, var(--color-rust-deep));">
                <svg class="mx-auto" width="52" height="52" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <rect x="3" y="10.5" width="4" height="3" rx="0.5"/>
                  <path d="M7 9 H14 A4 4 0 0 1 14 17 H7 Z"/>
                  <circle cx="11.5" cy="13" r="1.4" fill="var(--color-rust-deep)"/>
                  <circle cx="17.5" cy="7.5" r="1.3" fill="none" stroke="currentColor" stroke-width="1.4"/>
                </svg>
                <span class="block text-[12px] font-bold uppercase tracking-[0.2em] mt-2">SOS</span>
              </button>
            </div>
            <p class="mt-10 text-[13px] uppercase tracking-[0.18em] text-[var(--color-cream)]/65">Hold for one second</p>
            <p class="mt-2 font-display text-xl italic text-[var(--color-rust)]">"If you have a problem, just whistle."</p>
          </div>
        </article>

        <!-- 3 recipients vertical -->
        <ul class="space-y-3">
          {recipients.map((r) => (
            <li>
              <article class={`rounded-2xl border border-[var(--color-line)] p-5 md:p-6 ${r.tone === 'siren' ? 'bg-[color-mix(in_srgb,var(--color-siren)_8%,var(--color-cream))]' : 'bg-[var(--color-cream-2)]'}`}>
                <div class="flex items-baseline justify-between gap-3 mb-3 flex-wrap">
                  <span class="font-mono text-[11px]" style={`color: ${r.tone === 'siren' ? 'var(--color-siren-deep)' : 'var(--color-rust)'};`}>R.{r.n}</span>
                  <span class="text-[10.5px] uppercase tracking-wider text-[var(--color-ink)]/55 font-mono">{r.detail}</span>
                </div>
                <h3 class="font-display text-2xl tracking-tight">{r.title}</h3>
                <p class="mt-2 text-[14px] text-[var(--color-ink)]/70 leading-relaxed">{r.body}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <!-- audible whistle callout -->
      <div class="mt-12 rounded-2xl bg-[var(--color-cream-2)] border border-[var(--color-line)] p-6 md:p-8 grid grid-cols-1 md:grid-cols-[auto_1fr] gap-5 md:gap-8 items-center">
        <div class="grid place-items-center h-14 w-14 rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] shrink-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="3" y="10.5" width="4" height="3" rx="0.5"/>
            <path d="M7 9 H14 A4 4 0 0 1 14 17 H7 Z"/>
            <circle cx="11.5" cy="13" r="1.4" fill="var(--color-rust)"/>
            <circle cx="17.5" cy="7.5" r="1.3" fill="none" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </div>
        <div>
          <h3 class="font-display text-2xl tracking-tight">The phone whistles too.</h3>
          <p class="mt-2 text-[14px] text-[var(--color-ink)]/70 leading-relaxed max-w-3xl">
            On press, the phone speaker starts playing a high-frequency whistle at maximum volume - to startle the perpetrator,
            and to pull bystanders in. It stops only when you cancel with your PIN, or when a Singa Pen officer marks you safe.
            Optional, but on by default.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SINGA PEN PATROL -->
  <section class="relative bg-[var(--color-cream-2)] py-24 md:py-32">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-y-10 md:gap-10 items-end mb-14 md:mb-16">
        <div class="col-span-12 md:col-span-7">
          <span class="eyebrow text-[var(--color-siren-deep)]">The patrol</span>
          <h2 class="mt-3 font-display text-[36px] sm:text-[56px] md:text-[64px] leading-[1.0] tracking-[-0.02em] max-w-3xl">
            Singa Pen.<br/>
            <span class="italic font-[450]" style="color: var(--color-siren-deep);">A lion of a force.</span>
          </h2>
          <p class="mt-4 font-tamil text-2xl text-[var(--color-ink)]/55">சிங்கப்பெண்</p>
        </div>
        <div class="col-span-12 md:col-span-5">
          <p class="text-[15px] text-[var(--color-ink)]/70 max-w-md leading-relaxed">
            A dedicated women's patrol force, announced by the Tamil Nadu government. Every patrol vehicle runs the
            Whistle patrol app. When a Whistle alarm fires, the nearest vehicle gets the alert and a turn-by-turn route.
            Median arrival, statewide, is under four minutes.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <!-- patrol app mockup -->
        <article class="rounded-[28px] bg-[var(--color-cream)] border border-[var(--color-line)] p-6 md:p-8">
          <div class="flex items-center justify-between gap-3 mb-5 flex-wrap">
            <span class="rounded-full bg-[var(--color-siren)] text-[var(--color-cream)] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider">Patrol app</span>
            <span class="font-mono text-[11px] text-[var(--color-ink)]/45">Singa Pen vehicle #SP-238</span>
          </div>

          <!-- incoming alert card -->
          <div class="rounded-2xl bg-[var(--color-ink)] text-[var(--color-cream)] p-5 relative overflow-hidden">
            <div aria-hidden="true" class="absolute -top-12 -right-12 h-32 w-32 rounded-full blur-2xl opacity-40"
              style="background: radial-gradient(closest-side, var(--color-rust), transparent 70%);"></div>
            <div class="relative">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="relative flex">
                    <span class="absolute h-2.5 w-2.5 rounded-full bg-[var(--color-rust)] opacity-60 animate-ping"></span>
                    <span class="relative h-2.5 w-2.5 rounded-full bg-[var(--color-rust)]"></span>
                  </span>
                  <span class="text-[11px] uppercase tracking-wider text-[var(--color-rust)] font-bold">Incoming alert</span>
                </div>
                <span class="font-mono text-[10.5px] text-[var(--color-cream)]/55">09:42:18</span>
              </div>
              <p class="mt-3 font-display text-xl">Whistle &middot; W-04 821</p>
              <p class="text-[12.5px] text-[var(--color-cream)]/65 mt-1">Anna Nagar · 4th Avenue near AP-12</p>
              <div class="mt-4 grid grid-cols-3 gap-2 text-center">
                <div class="rounded-xl bg-[var(--color-cream)]/8 p-2">
                  <p class="text-[10px] uppercase tracking-wider text-[var(--color-cream)]/55">Distance</p>
                  <p class="font-display text-base mt-0.5">1.2 km</p>
                </div>
                <div class="rounded-xl bg-[var(--color-cream)]/8 p-2">
                  <p class="text-[10px] uppercase tracking-wider text-[var(--color-cream)]/55">ETA</p>
                  <p class="font-display text-base mt-0.5">3 m 40 s</p>
                </div>
                <div class="rounded-xl bg-[var(--color-cream)]/8 p-2">
                  <p class="text-[10px] uppercase tracking-wider text-[var(--color-cream)]/55">ID</p>
                  <p class="font-display text-base mt-0.5">Verified</p>
                </div>
              </div>
              <button class="mt-4 w-full rounded-full bg-[var(--color-rust)] text-[var(--color-cream)] py-3 text-[13px] font-semibold">
                Accept &amp; start route
              </button>
            </div>
          </div>

          <!-- patrol log -->
          <div class="mt-5 rounded-xl bg-[var(--color-cream-2)] p-4">
            <p class="text-[10px] uppercase tracking-wider text-[var(--color-ink)]/50 mb-2">Today</p>
            <ul class="space-y-2 text-[12.5px]">
              <li class="flex items-center justify-between">
                <span>3 alerts responded</span>
                <span class="font-mono text-[var(--color-leaf-deep)]">all cleared</span>
              </li>
              <li class="flex items-center justify-between">
                <span>Median response</span>
                <span class="font-mono">3 m 11 s</span>
              </li>
              <li class="flex items-center justify-between">
                <span>Patrol km</span>
                <span class="font-mono">38.4</span>
              </li>
            </ul>
          </div>
        </article>

        <!-- patrol map mockup -->
        <article class="rounded-[28px] bg-[var(--color-ink)] text-[var(--color-cream)] p-6 md:p-8 relative overflow-hidden">
          <div aria-hidden="true" class="absolute inset-0 opacity-40"
            style="background: radial-gradient(circle at 70% 30%, color-mix(in srgb, var(--color-siren) 30%, transparent), transparent 60%);"></div>

          <div class="relative">
            <div class="flex items-center justify-between gap-3 mb-5 flex-wrap">
              <span class="rounded-full bg-[var(--color-cream)]/10 border border-[var(--color-cream)]/20 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider">Live coverage</span>
              <span class="font-mono text-[11px] text-[var(--color-cream)]/55">Anna Nagar &middot; TN-03</span>
            </div>

            <!-- abstract grid map with vehicle dots -->
            <div class="relative rounded-2xl border border-[var(--color-cream)]/15 overflow-hidden h-[280px] bg-[color-mix(in_srgb,var(--color-ink)_85%,var(--color-siren))]">
              <svg viewBox="0 0 400 280" class="absolute inset-0 w-full h-full">
                <defs>
                  <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(250,247,242,0.07)" stroke-width="0.5"/>
                  </pattern>
                </defs>
                <rect width="400" height="280" fill="url(#grid)"/>
                <!-- roads -->
                <path d="M 0 110 L 400 130" stroke="rgba(250,247,242,0.12)" stroke-width="1.2" fill="none"/>
                <path d="M 0 200 L 400 195" stroke="rgba(250,247,242,0.12)" stroke-width="1.2" fill="none"/>
                <path d="M 120 0 L 130 280" stroke="rgba(250,247,242,0.12)" stroke-width="1.2" fill="none"/>
                <path d="M 280 0 L 270 280" stroke="rgba(250,247,242,0.12)" stroke-width="1.2" fill="none"/>
                <!-- patrol vehicle dots (siren blue) -->
                <g>
                  <circle cx="80" cy="160" r="6" fill="var(--color-siren)"/>
                  <circle cx="80" cy="160" r="11" fill="none" stroke="var(--color-siren)" stroke-width="1" opacity="0.4"/>
                </g>
                <g>
                  <circle cx="220" cy="80" r="6" fill="var(--color-siren)"/>
                  <circle cx="220" cy="80" r="11" fill="none" stroke="var(--color-siren)" stroke-width="1" opacity="0.4"/>
                </g>
                <g>
                  <circle cx="320" cy="220" r="6" fill="var(--color-siren)"/>
                  <circle cx="320" cy="220" r="11" fill="none" stroke="var(--color-siren)" stroke-width="1" opacity="0.4"/>
                </g>
                <!-- active alert (rust) -->
                <g>
                  <circle cx="190" cy="170" r="8" fill="var(--color-rust)">
                    <animate attributeName="r" from="6" to="12" dur="1.4s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" from="0.9" to="0.4" dur="1.4s" repeatCount="indefinite"/>
                  </circle>
                  <circle cx="190" cy="170" r="6" fill="var(--color-rust)"/>
                </g>
                <!-- route line -->
                <path d="M 220 80 Q 200 130 190 170" fill="none" stroke="var(--color-rust)" stroke-width="2" stroke-dasharray="4 4">
                  <animate attributeName="stroke-dashoffset" from="0" to="-16" dur="0.8s" repeatCount="indefinite"/>
                </path>
              </svg>
            </div>

            <div class="mt-4 flex items-center justify-between text-[12px] flex-wrap gap-3">
              <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style="background: var(--color-siren);"></span><span>3 patrols</span></span>
                <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--color-rust)]"></span><span>1 active alert</span></span>
              </div>
              <span class="font-mono text-[11px] text-[var(--color-cream)]/55">visible to administration only</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ADMIN DASHBOARD + ANOMALIES -->
  <section class="bg-[var(--color-ink)] text-[var(--color-cream)] py-24 md:py-32 relative overflow-hidden">
    <div aria-hidden="true" class="absolute -top-32 left-1/2 -translate-x-1/2 h-[500px] w-[900px] rounded-full blur-3xl opacity-10"
      style="background: radial-gradient(closest-side, var(--color-siren), transparent 70%);"></div>

    <div class="container-x relative">
      <div class="grid grid-cols-12 gap-y-10 md:gap-10 items-end mb-14 md:mb-16">
        <div class="col-span-12 md:col-span-7">
          <span class="eyebrow" style="color: color-mix(in srgb, var(--color-siren) 80%, white);">Inside the oversight</span>
          <h2 class="mt-3 font-display text-[36px] sm:text-[56px] md:text-[64px] leading-[1.0] tracking-[-0.02em] max-w-3xl">
            Anomalies surface.<br/>
            <span class="italic font-[450] text-[var(--color-rust)]">Action follows.</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-5">
          <p class="text-[15px] text-[var(--color-cream)]/70 max-w-md leading-relaxed">
            The administration sees a live grid of every Singa Pen vehicle on duty - and an anomaly detector that flags
            patrol behaviour that doesn't match the schedule. Idle vehicles, off-route patrolling, lost officer signals,
            active responses - all visible at a glance.
          </p>
        </div>
      </div>

      <!-- anomalies grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-cream)]/12 rounded-2xl overflow-hidden">
        {anomalies.map((a) => (
          <article class="bg-[var(--color-ink)] p-6 md:p-7">
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-[11px]"
                style={`color: ${a.tone === 'rust' ? 'var(--color-rust)' : a.tone === 'leaf' ? 'var(--color-leaf)' : a.tone === 'amber' ? 'rgb(217,119,6)' : 'var(--color-cream)'};`}>
                {a.code}
              </span>
              <span class="text-[10px] uppercase tracking-wider text-[var(--color-cream)]/55 font-mono">{a.chip}</span>
            </div>
