          <div class="flex items-center gap-3 text-[11px] font-mono flex-wrap">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style="background: var(--color-siren);"></span>62 on duty</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-[var(--color-rust)]"></span>3 responding</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-amber-500"></span>2 anomalies</span>
