---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import MakkalKuralSection from '../components/sections/MakkalKuralSection.astro';
import InOutSection from '../components/sections/InOutSection.astro';
import ThittamSection from '../components/sections/ThittamSection.astro';
import WhistleSection from '../components/sections/WhistleSection.astro';
import Principles from '../components/sections/Principles.astro';
import ClosingCTA from '../components/sections/ClosingCTA.astro';
import { apps } from '../data/apps';

const title = 'tvkapps - A suite of citizen apps for Tamil Nadu';
const description =
  "A Tamil-first, open-source suite of apps for Tamil Nadu citizens: requests and reviews for government offices, public oversight of TASMAC shops, welfare scheme discovery, and one-tap women safety. If you have a problem, just whistle.";

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'tvkapps',
  url: 'https://tvkapps.example',
  description,
  sameAs: [],
};

const itemListJson = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: apps.map((a, i) => ({
    '@type': 'SoftwareApplication',
    position: i + 1,
    name: a.name,
    description: a.shortDescription,
    applicationCategory: a.category,
    operatingSystem: 'Android',
    url: `https://tvkapps.example/apps/${a.slug}`,
  })),
};
---
<Base title={title} description={description}>
  <section id="suite" class="sr-only" aria-hidden="true"></section>
  <HomeHero />
  <MakkalKuralSection />
  <InOutSection />
  <ThittamSection />
  <WhistleSection />
  <Principles />
  <ClosingCTA />

  <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
</Base>
